{
  "name": "tweakers",
  "version": "1.2.0",
  "description": "Shared tweak state core plus the Ableton Move bottom-sheet surface (React)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      },
      "require": {
        "types": "./dist/store/index.d.cts",
        "default": "./dist/store/index.cjs"
      }
    },
    "./timeline": {
      "import": {
        "types": "./dist/timeline/index.d.ts",
        "default": "./dist/timeline/index.js"
      },
      "require": {
        "types": "./dist/timeline/index.d.cts",
        "default": "./dist/timeline/index.cjs"
      }
    },
    "./curve-composer-core": {
      "types": "./dist/curve-composer-core.d.ts",
      "default": "./dist/curve-composer-core.js"
    },
    "./modulation-core": {
      "types": "./dist/modulation-core.d.ts",
      "default": "./dist/modulation-core.js"
    },
    "./modulation-store": {
      "types": "./dist/modulation-store.d.ts",
      "default": "./dist/modulation-store.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills/tweakers-integration"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:timeline": "tsx --test src/*.test.ts",
    "snapshot": "node scripts/snapshot-package.mjs"
  },
  "peerDependencies": {
    "motion": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-test-renderer": "^18.3.1",
    "motion": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.3.1",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "react",
    "move",
    "ableton-move",
    "tweaking",
    "parameters",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/criztiano/tweakers"
  }
}
